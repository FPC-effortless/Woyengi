{
  "name": "@woyengi/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "bin": {
    "woyengi": "packages/cli/src/bin.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "boundaries": "node scripts/package-boundaries.mjs && node production/scripts/deep_module_enforce.js",
    "test": "node --test",
    "test:python": "node scripts/run-python-tests.mjs",
    "test:all": "node --test && node scripts/run-python-tests.mjs",
    "test:coverage": "node --test --experimental-test-coverage",
    "benchmark": "node benchmarks/adversarial/src/run.ts",
    "woyengi": "node packages/cli/src/bin.ts",
    "explorer": "node apps/explorer/src/demo.ts",
    "prod:check": "node production/scripts/production-os.js --profile standard",
    "prod:check:fast": "node production/scripts/production-os.js --profile fast",
    "prod:release": "node production/scripts/production-os.js --profile release"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
