{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:woyengi:wil-rbs:schema:v1",
  "title": "WIL-RBS v1 research records",
  "description": "Structural interchange schema. The stdlib Python validator additionally enforces cross-field and relational constraints. Do not treat this document as a scientific qualification gate.",
  "type": "object",
  "required": [
    "schema",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "wil-rbs.v1"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/run"
          },
          {
            "$ref": "#/$defs/evaluation"
          },
          {
            "$ref": "#/$defs/historical"
          },
          {
            "$ref": "#/$defs/checkpoint"
          }
        ]
      }
    },
    "import_metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "level",
        "refs"
      ],
      "properties": {
        "level": {
          "enum": [
            "reported",
            "source_reproduced",
            "independently_verified"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "source_note": {
          "type": "string"
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "family",
        "trainable_parameters",
        "deployed_parameters"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "trainable_parameters": {
          "type": "integer",
          "minimum": 1
        },
        "deployed_parameters": {
          "type": "integer",
          "minimum": 1
        },
        "config_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "metric": {
      "type": "object",
      "required": [
        "name",
        "unit",
        "direction",
        "value",
        "split",
        "target_count"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "min",
            "max"
          ]
        },
        "value": {
          "type": "number"
        },
        "split": {
          "type": "string",
          "minLength": 1
        },
        "target_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "target_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "evaluator_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol_mode": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "dataset_id",
        "target_unit",
        "train_exposure_units",
        "context_length"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "target_unit": {
          "type": "string",
          "minLength": 1
        },
        "train_exposure_units": {
          "type": "integer",
          "minimum": 1
        },
        "context_length": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "training": {
      "type": "object",
      "required": [
        "optimizer",
        "updates"
      ],
      "properties": {
        "optimizer": {
          "type": "string",
          "minLength": 1
        },
        "updates": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "training_flops"
      ],
      "properties": {
        "wall_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "flop_budget": {
          "type": [
            "number",
            "null"
          ]
        },
        "training_flops": {
          "type": "object",
          "required": [
            "method",
            "value"
          ],
          "properties": {
            "method": {
              "enum": [
                "unavailable",
                "analytical_estimate",
                "operator_census",
                "measured_profiler"
              ]
            },
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "scope": {
              "type": "string"
            },
            "receipt_ref": {
              "type": "string"
            }
          }
        },
        "time_budget_seconds": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "inference_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/inference_profile"
            },
            {
              "type": "null"
            }
          ]
        },
        "quality_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/quality_target"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "base": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "project_id",
        "study_id",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "study_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "run": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "arm_id",
            "seed",
            "model",
            "data",
            "training",
            "resources"
          ],
          "properties": {
            "kind": {
              "const": "run"
            },
            "arm_id": {
              "type": "string"
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "model": {
              "$ref": "#/$defs/model"
            },
            "data": {
              "$ref": "#/$defs/data"
            },
            "training": {
              "$ref": "#/$defs/training"
            },
            "resources": {
              "$ref": "#/$defs/resources"
            },
            "runtime": {
              "anyOf": [
                {
                  "$ref": "#/$defs/runtime"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "evaluation": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "run_id",
            "metric"
          ],
          "properties": {
            "kind": {
              "const": "evaluation"
            },
            "run_id": {
              "type": "string"
            },
            "metric": {
              "$ref": "#/$defs/metric"
            },
            "checkpoint_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "historical": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "seed_count",
            "model",
            "data",
            "training",
            "resources",
            "metric"
          ],
          "properties": {
            "kind": {
              "const": "historical_aggregate"
            },
            "seed_count": {
              "type": "integer",
              "minimum": 1
            },
            "model": {
              "$ref": "#/$defs/model"
            },
            "data": {
              "$ref": "#/$defs/data"
            },
            "training": {
              "$ref": "#/$defs/training"
            },
            "resources": {
              "$ref": "#/$defs/resources"
            },
            "metric": {
              "$ref": "#/$defs/metric"
            },
            "runtime": {
              "anyOf": [
                {
                  "$ref": "#/$defs/runtime"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "runtime": {
      "type": "object",
      "required": [
        "hardware_id",
        "software_sha256",
        "precision"
      ],
      "properties": {
        "hardware_id": {
          "type": "string",
          "minLength": 1
        },
        "software_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "precision": {
          "type": "string",
          "minLength": 1
        },
        "cpu_threads": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "inference_profile": {
      "type": "object",
      "required": [
        "workload_sha256",
        "software_sha256",
        "hardware_id",
        "precision",
        "unit",
        "mode",
        "batch_size",
        "decode_ms_per_unit",
        "cache_parity_verified"
      ],
      "properties": {
        "workload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "software_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hardware_id": {
          "type": "string"
        },
        "precision": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "decode_ms_per_unit": {
          "type": "number",
          "minimum": 0
        },
        "cache_parity_verified": {
          "type": "boolean"
        }
      }
    },
    "quality_target": {
      "type": "object",
      "required": [
        "metric",
        "unit",
        "direction",
        "threshold",
        "validation_contract_sha256",
        "time_to_target_seconds"
      ],
      "properties": {
        "metric": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "min",
            "max"
          ]
        },
        "threshold": {
          "type": "number"
        },
        "validation_contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "time_to_target_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "checkpoint": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "run_id",
            "step",
            "checkpoint_sha256"
          ],
          "properties": {
            "kind": {
              "const": "checkpoint"
            },
            "run_id": {
              "type": "string",
              "minLength": 1
            },
            "step": {
              "type": "integer",
              "minimum": 0
            },
            "checkpoint_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "artifact_name": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
